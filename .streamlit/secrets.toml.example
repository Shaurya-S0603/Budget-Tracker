# Copy into Streamlit Cloud -> App settings -> Secrets.
# Create a fine-grained GitHub token with Contents: Read and write access
# to the repository that will hold the SQLite database.
# Never commit the real token to GitHub.
[github]
token = "github_pat_REPLACE_ME"
repo = "Shaurya-S0603/Budget-Tracker"
branch = "main"
db_path = "data/expenses.db"
